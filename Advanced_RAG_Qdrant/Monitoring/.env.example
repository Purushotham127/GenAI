# Add these to the existing project-root .env; do not replace the RAG settings.
MONITORING_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LITELLM_PORT=4000
MONITORING_UI_PORT=8502

# Optional. The proxy uses a random local key when this is not set.
# LITELLM_MASTER_KEY=sk-your-local-proxy-key

# Optional Langfuse Cloud/self-hosted tracing. Set both keys to enable.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
